<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_header_green" android:padding="20dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:background="@drawable/bg_circle_white_alpha" android:src="@drawable/ic_back" android:padding="6dp" android:contentDescription="Kembali"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Statistik Layanan" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
        </RelativeLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp">
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#E3F2FD">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvTotalGangguan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/sijaga_primary" android:textSize="28sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gangguan" android:textColor="@color/sijaga_primary" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#E8F5E9">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvTotalPasang" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/status_selesai" android:textSize="28sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pasang Baru" android:textColor="@color/status_selesai" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp">
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvDiproses" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/status_diproses" android:textSize="28sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diproses" android:textColor="@color/status_diproses" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFEBEE">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvDitolak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/status_ditolak" android:textSize="28sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ditolak" android:textColor="@color/status_ditolak" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="40sp"/>
                <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" android:indeterminateTint="@color/color_staff"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Grafik Laporan per Bulan" android:textColor="@color/text_hint" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" android:text="Rekap per Wilayah" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvWilayah" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
