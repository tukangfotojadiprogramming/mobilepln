<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardCornerRadius="16dp"
    app:cardElevation="3dp" app:cardBackgroundColor="@color/bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <!-- Header row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_icon_circle" android:gravity="center">
                <TextView android:id="@+id/tvIkon" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="⚠️" android:textSize="20sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/tvJenis" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Laporan Gangguan"
                    android:textColor="@color/text_secondary" android:textSize="11sp"/>
                <TextView android:id="@+id/tvNomor" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="#LG-20240001"
                    android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/tvStatusBadge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Diproses"
                android:textColor="@color/status_diproses" android:textSize="11sp" android:textStyle="bold"
                android:background="@color/status_diproses_bg" android:paddingStart="10dp"
                android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
        </LinearLayout>
        <!-- Lokasi & Tanggal -->
        <TextView android:id="@+id/tvLokasi" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📍 Jl. Sudirman No. 10, Jakarta"
            android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvTanggal" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🕒 01 Jan 2025, 10:30"
            android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="14dp"/>
        <!-- Timeline steps -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <!-- Step 1 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:id="@+id/dot1" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_timeline_dot_done" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✓" android:textColor="@color/white" android:textSize="11sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Diterima"
                    android:textColor="@color/status_selesai" android:textSize="10sp" android:gravity="center"/>
            </LinearLayout>
            <View android:id="@+id/line1" android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="0.5" android:background="@color/status_selesai"/>
            <!-- Step 2 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:id="@+id/dot2" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_timeline_dot" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="2" android:textColor="@color/white" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Diproses"
                    android:textColor="@color/sijaga_primary" android:textSize="10sp" android:gravity="center"/>
            </LinearLayout>
            <View android:id="@+id/line2" android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="0.5" android:background="@color/divider"/>
            <!-- Step 3 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:id="@+id/dot3" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_timeline_dot_inactive" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="3" android:textColor="@color/white" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Ditugaskan"
                    android:textColor="@color/text_hint" android:textSize="10sp" android:gravity="center"/>
            </LinearLayout>
            <View android:id="@+id/line3" android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="0.5" android:background="@color/divider"/>
            <!-- Step 4 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:id="@+id/dot4" android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/bg_timeline_dot_inactive" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="4" android:textColor="@color/white" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Selesai"
                    android:textColor="@color/text_hint" android:textSize="10sp" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>
        <!-- Detail button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDetail"
            style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginTop="14dp" android:text="Lihat Detail"
            android:textSize="13sp" app:strokeColor="@color/sijaga_primary"
            android:textColor="@color/sijaga_primary"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
