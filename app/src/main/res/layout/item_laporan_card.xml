<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="14dp"
    app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/bg_icon_circle" android:gravity="center">
            <TextView android:id="@+id/tvIkon" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="⚠️" android:textSize="20sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/tvJudul" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Gangguan Listrik"
                android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvLokasi" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="📍 Jl. Sudirman"
                android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/tvTanggal" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="01 Jan 2025"
                android:textColor="@color/text_hint" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- ImageView untuk Foto -->
        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:background="@color/divider"
            android:visibility="gone" />

        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Diproses"
            android:textColor="@color/status_diproses" android:textSize="11sp" android:textStyle="bold"
            android:background="@color/status_diproses_bg"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
